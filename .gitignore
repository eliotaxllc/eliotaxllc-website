# Files Git should never save or publish.

# Windows and Mac system junk
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# Temporary files from Office and editors
~$*
*.tmp
*.bak

# Local tool settings (specific to this computer)
.claude/settings.local.json
.vscode/

# Brand originals that stay on this computer only (decided M3):
# the PDF and JPG contain hidden personal details from the designer's computer,
# and the .ai can't be fully checked. Only the clean PNG original is published.
brand/ElioTax_ColorCodes.pdf
brand/ElioTax_FinalLogo_Large.jpg
brand/ElioTax_FinalLogo.ai

# Private notes that stay on this computer only (decided M7): WISP notes etc.
private/

# Safety net: things that must never go public
*recovery-codes*
*recovery_codes*
.env
*.pem
*.key
